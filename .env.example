# ============================================================
# ZenWork - Environment Variables
# ============================================================

# ----------------------------------------------------------
# DATABASE PROVIDER
# ----------------------------------------------------------
# Local (default): sqlite
# Production: postgresql | mysql
ZENWORK_DB_PROVIDER=sqlite

# ----------------------------------------------------------
# DATABASE URL
# ----------------------------------------------------------
# Local (SQLite): no hace falta definir nada acá, packages/db usa por
# defecto un archivo dentro de packages/ (packages/zenwork-local.db).
#
# Producción (PostgreSQL, ej. Neon): las dos URLs de conexión que da el
# proveedor. La "pooled" para la app en runtime, la "directa"/"unpooled"
# para poder aplicar migraciones (Neon y similares no soportan migraciones
# sobre la conexión con pooling).
# ZENWORK_DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# ZENWORK_DATABASE_URL_UNPOOLED=postgresql://user:password@host-direct/db?sslmode=require
#
# MySQL: mysql://user:password@host:3306/zenwork_db

# ----------------------------------------------------------
# REDIS (opcional, solo para colas y rate limiting en prod)
# ----------------------------------------------------------
# ZENWORK_REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# JWT
# ----------------------------------------------------------
# ¡IMPORTANTE! Estos valores deben coincidir con apps/web/.env.local
ZENWORK_JWT_SECRET=dev-jwt-secret-change-in-production-zenwork
ZENWORK_JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-zenwork

# ----------------------------------------------------------
# OAuth (Discord) - inicio de sesión con Discord
# Registra la app "ZenWork" en https://discord.com/developers/applications
# Redirect URI: {ZENWORK_APP_URL}/api/auth/callback/discord
# ----------------------------------------------------------
ZENWORK_DISCORD_CLIENT_ID=your-discord-client-id
ZENWORK_DISCORD_CLIENT_SECRET=your-discord-client-secret

# ----------------------------------------------------------
# OAuth (GitHub) - inicio de sesión con GitHub
# Registra la app OAuth "ZenWork" en https://github.com/settings/developers
# Redirect URI: {ZENWORK_APP_URL}/api/auth/callback/github
# En "Request user authorization scope" marca: user:email
# ----------------------------------------------------------
ZENWORK_GITHUB_CLIENT_ID=
ZENWORK_GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------
# 2FA
# ----------------------------------------------------------
ZENWORK_2FA_ISSUER=ZenWork
ZENWORK_2FA_SECRET_KEY=your-2fa-encryption-key

# ----------------------------------------------------------
# EMAIL (Resend / SendGrid - alternativo)
# ----------------------------------------------------------
# ZENWORK_EMAIL_PROVIDER=resend
# ZENWORK_RESEND_API_KEY=your-resend-api-key
# ZENWORK_SENDGRID_API_KEY=
# ZENWORK_EMAIL_FROM=notificaciones@zenwork.com

# ----------------------------------------------------------
# EMAIL (SMTP via Resend) - usado por las invitaciones a miembros
# ----------------------------------------------------------
# Host = smtp.resend.com | Port 465 (SSL) o 587 (STARTTLS)
# User = resend | Pass = TU API key de Resend (la única que te dan).
# From: debe ser de tu dominio VERIFICADO en Resend (e.g. zenforge.online).
ZENWORK_SMTP_HOST=smtp.resend.com
ZENWORK_SMTP_PORT=465
ZENWORK_SMTP_USER=resend
ZENWORK_SMTP_PASS=TU_API_KEY_DE_RESEND
ZENWORK_SMTP_FROM="ZenWork <no-reply@zenforge.online>"

# ----------------------------------------------------------
# DISCORD WEBHOOKS
# ----------------------------------------------------------
# ZENWORK_DISCORD_BOT_TOKEN=your-discord-bot-token
# ZENWORK_DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# ----------------------------------------------------------
# S3 / CLOUDFLARE R2
# ----------------------------------------------------------
# ZENWORK_S3_ENDPOINT=
# ZENWORK_S3_REGION=auto
# ZENWORK_S3_ACCESS_KEY_ID=
# ZENWORK_S3_SECRET_ACCESS_KEY=
# ZENWORK_S3_BUCKET=zenwork-assets

# ----------------------------------------------------------
# WEBHOOKS
# ----------------------------------------------------------
# ZENWORK_WEBHOOK_SECRET=your-webhook-hmac-secret

# ----------------------------------------------------------
# APP CONFIG
# ----------------------------------------------------------
ZENWORK_APP_URL=http://localhost:3000
ZENWORK_APP_NAME=ZenWork
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development